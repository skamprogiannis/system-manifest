+package providers
+
+import "testing"
+
+func TestHomeManagerParenthesizedLuaBindings(t *testing.T) {
+	content := `local mod = "SUPER"
+hl.bind((mod .. " + d"), (hl.dsp.exec_cmd("dms ipc call spotlight toggle")))
+hl.bind(((mod) .. (" + SHIFT + w")), ((hl.dsp.exec_cmd("dms ipc call dash toggle wallpaper"))), { description = "Wallpaper" })
+hl.bind(("Print"), (hl.dsp.exec_cmd("dms screenshot region --dir ~/pictures/screenshots")))
+hl.bind((mod .. " + f"), (hl.dsp.window.fullscreen({ mode = "fullscreen", action = "toggle" })))`
+	parser := NewHyprlandParser("")
+	section, err := parser.parseLuaLines(content, "", "test.lua", "")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(section.Keybinds) != 4 {
+		t.Fatalf("got %d binds, want 4", len(section.Keybinds))
+	}
+	for i, want := range []struct{ key, dispatcher, params string }{
+		{"SUPER+d", "exec", "dms ipc call spotlight toggle"},
+		{"SUPER+SHIFT+w", "exec", "dms ipc call dash toggle wallpaper"},
+		{"Print", "exec", "dms screenshot region --dir ~/pictures/screenshots"},
+		{"SUPER+f", "fullscreen", "0"},
+	} {
+		kb := &section.Keybinds[i]
+		if key := parser.formatBindKey(kb); key != want.key || kb.Dispatcher != want.dispatcher || kb.Params != want.params {
+			t.Errorf("got %s: %s %q, want %+v", key, kb.Dispatcher, kb.Params, want)
+		}
+	}
+	if section.Keybinds[1].Comment != "Wallpaper" {
+		t.Errorf("lost description: %q", section.Keybinds[1].Comment)
+	}
+}
+
+func TestLuaParenthesizedConcat(t *testing.T) {
+	env := luaVarEnv{"mod": "SUPER"}
+	for _, expr := range []string{`(mod .. " + d")`, `((mod) .. (" + d"))`, `(mod) .. (" + d")`} {
+		got, ok := evalLuaConcat(expr, env)
+		if !ok || got != "SUPER + d" {
+			t.Errorf("%s = %q, %v", expr, got, ok)
+		}
+	}
+	for _, expr := range []string{`(unknown .. " + d")`, `(mod .. " + d"`, `(mod)..run()`} {
+		if got, ok := evalLuaConcat(expr, env); ok {
+			t.Errorf("resolved unsupported %q to %q", expr, got)
+		}
+	}
+}
