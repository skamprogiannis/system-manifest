# Shared list of MIME types for text and code files opened by the default editor (Neovim in Ghostty).
[
  # Plain text & markup
  "text/plain"
  "text/markdown"

  # Go
  "text/x-go"

  # Python
  "text/x-python"
  "text/x-script.python"
  "application/x-python-code"

  # Rust
  "text/rust"
  "text/x-rust"

  # C / C++
  "text/x-c"
  "text/x-csrc"
  "text/x-chdr"
  "text/x-c++"
  "text/x-c++src"
  "text/x-c++hdr"

  # Nix
  "text/x-nix"

  # JavaScript / TypeScript / Web
  "text/javascript"
  "application/javascript"
  "text/x-javascript"
  "text/x-typescript"
  "application/x-typescript"
  "application/typescript"
  "text/vnd.trolltech.linguist"
  "text/jsx"
  "text/tsx"
  "text/x-svelte"
  "text/css"
  "text/x-scss"
  "text/x-sass"
  "text/x-less"

  # Shell & scripts
  "text/x-shellscript"
  "application/x-shellscript"
  "application/x-sh"
  "text/x-sh"
  "text/x-zsh"
  "text/x-lua"

  # Config & data formats
  "application/json"
  "text/x-json"
  "text/yaml"
  "text/x-yaml"
  "application/yaml"
  "application/x-yaml"
  "text/x-toml"
  "application/toml"
  "text/x-ini"

  # Database
  "text/x-sql"
  "application/sql"
  "application/x-sql"

  # Other programming languages
  "text/x-java"
  "text/x-kotlin"
  "text/x-ruby"
  "application/x-ruby"
  "text/x-php"
  "application/x-php"
  "text/x-zig"
  "text/x-cmake"
  "text/x-makefile"
]
